+JNIEXPORT jlongArray JNICALL
+Java_com_novaping_app_HevMetadataNative_nativePoll (JNIEnv *env, jobject thiz)
+{
+    np_packet_metadata_t record;
+    jlong values[9];
+    uint64_t address_hi = 0;
+    uint64_t address_lo = 0;
+    jlongArray result;
+    size_t i;
+
+    if (!hev_socks5_tunnel_metadata_poll (&record))
+        return NULL;
+
+    for (i = 0; i < 8; i++)
+        address_hi = (address_hi << 8) | record.remote_address[i];
+    for (i = 8; i < 16; i++)
+        address_lo = (address_lo << 8) | record.remote_address[i];
+
+    values[0] = record.ip_version;
+    values[1] = record.address_length;
+    values[2] = record.transport;
+    values[3] = record.direction;
+    values[4] = (jlong)address_hi;
+    values[5] = (jlong)address_lo;
+    values[6] = record.remote_port;
+    values[7] = record.packet_length_bytes;
+    values[8] = record.fragmented;
+
+    result = (*env)->NewLongArray (env, 9);
+    if (!result)
+        return NULL;
+    (*env)->SetLongArrayRegion (env, result, 0, 9, values);
+    return result;
+}
+
+JNIEXPORT jlong JNICALL
+Java_com_novaping_app_HevMetadataNative_nativeDropped (JNIEnv *env, jobject thiz)
+{
+    return (jlong)hev_socks5_tunnel_metadata_dropped ();
+}
+
 #endif /* ANDROID */
