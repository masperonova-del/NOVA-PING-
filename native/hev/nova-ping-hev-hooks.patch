+/*
+ * NOVA PING observes headers synchronously while the pbuf is valid.
+ * The metadata queues are diagnostic-only: a rejected sample or full queue
+ * must never change the original pbuf or the tunnel return value.
+ */
+static np_metadata_tap_t nova_metadata_tap_input;
+static np_metadata_tap_t nova_metadata_tap_output;
+static unsigned int nova_metadata_poll_cursor;
+static np_local_address_t nova_metadata_local_addresses[2];
+static size_t nova_metadata_local_address_count;
+
+static uint16_t
+nova_pbuf_copy_partial (const void *opaque, void *destination,
+                        uint16_t length, uint16_t offset)
+{
+    const struct pbuf *p = opaque;
+
+    if (!p)
+        return 0;
+
+    return pbuf_copy_partial (p, destination, length, offset);
+}
+
+static void
+nova_metadata_init (void)
+{
+    const char *ipv4;
+    const char *ipv6;
+    struct in_addr addr4;
+    struct in6_addr addr6;
+
+    nova_metadata_local_address_count = 0;
+    memset (nova_metadata_local_addresses, 0,
+            sizeof (nova_metadata_local_addresses));
+
+    (void)np_metadata_tap_init (&nova_metadata_tap_input);
+    (void)np_metadata_tap_init (&nova_metadata_tap_output);
+
+    ipv4 = hev_config_get_tunnel_ipv4_address ();
+    if (ipv4 && inet_pton (AF_INET, ipv4, &addr4) == 1) {
+        np_local_address_t *local =
+            &nova_metadata_local_addresses[nova_metadata_local_address_count++];
+        local->family = NP_ADDRESS_IPV4;
+        memcpy (local->bytes, &addr4, sizeof (addr4));
+    }
+
+    ipv6 = hev_config_get_tunnel_ipv6_address ();
+    if (ipv6 && inet_pton (AF_INET6, ipv6, &addr6) == 1) {
+        np_local_address_t *local =
+            &nova_metadata_local_addresses[nova_metadata_local_address_count++];
+        local->family = NP_ADDRESS_IPV6;
+        memcpy (local->bytes, &addr6, sizeof (addr6));
+    }
+}
+
+static void
+nova_metadata_observe (const struct pbuf *p, np_metadata_tap_t *tap)
+{
+    np_packet_reader_t reader;
+    np_pbuf_reader_context_t context;
+
+    if (!tap || !tap->ready || !p ||
+        !nova_metadata_local_address_count)
+        return;
+
+    if (!np_pbuf_reader_init (&reader, &context, p, p->tot_len,
+                              nova_pbuf_copy_partial))
+        return;
+
+    (void)np_metadata_tap_observe (tap, &reader,
+                                   nova_metadata_local_addresses,
+                                   nova_metadata_local_address_count);
+}
