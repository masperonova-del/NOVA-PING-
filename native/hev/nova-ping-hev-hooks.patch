 }
+
+/*
+ * Exactly one consumer must drain both queues. JNI integration should call this from
+ * one dedicated polling executor, never from multiple UI or worker threads.
+ */
+EXPORT_SYMBOL int
+hev_socks5_tunnel_metadata_poll (np_packet_metadata_t *record)
+{
+    if (!record)
+        return 0;
+    if (nova_metadata_poll_cursor == 0) {
+        nova_metadata_poll_cursor = 1;
+        if (np_metadata_tap_poll (&nova_metadata_tap_input, record))
+            return 1;
+        return np_metadata_tap_poll (&nova_metadata_tap_output, record) ? 1 : 0;
+    }
+    nova_metadata_poll_cursor = 0;
+    if (np_metadata_tap_poll (&nova_metadata_tap_output, record))
+        return 1;
+    return np_metadata_tap_poll (&nova_metadata_tap_input, record) ? 1 : 0;
+}
+
+EXPORT_SYMBOL uint32_t
+hev_socks5_tunnel_metadata_dropped (void)
+{
+    return np_metadata_tap_dropped (&nova_metadata_tap_input) +
+           np_metadata_tap_dropped (&nova_metadata_tap_output);
+}
+
+EXPORT_SYMBOL int
+hev_socks5_tunnel_is_running (void)
+{
+    return atomic_load (&nova_tunnel_running);
+}
